#########################################################
# Authentication Configuration
#########################################################
# Your Zoom OAuth Client ID (required)
ZM_RTMS_CLIENT=

# Your Zoom OAuth Client Secret (required). Also decrypts the app context Zoom
# sends with each panel load, which is how the server knows who is asking.
ZM_RTMS_SECRET=

#########################################################
# Webhook Server Configuration (optional)
#########################################################
# TCP port for webhook server to listen on
# ZM_RTMS_PORT=8080

# URL path for webhook server to listen on
# ZM_RTMS_PATH=/

#########################################################
# SSL/TLS Certificates (optional)
#########################################################
# Path to CA certificate for RTMS connections - uses system CAs if not specified
# ZM_RTMS_CA=/path/to/ca.pem

# Path to SSL certificate file for HTTPS webhook server
# ZM_RTMS_CERT=/path/to/cert.pem

# Path to SSL certificate key file for HTTPS webhook server
# ZM_RTMS_KEY=/path/to/key.pem

# Path to CA certificate for webhook client verification (optional)
# ZM_RTMS_CA_WEBHOOK=/path/to/ca_webhook.pem

#########################################################
# Logging Configuration (optional)
#########################################################
# Log level for verbosity (error, warn, info, debug, trace)
# ZM_RTMS_LOG_LEVEL=info

# Log format (progressive for human-readable, json for machine-readable)
# ZM_RTMS_LOG_FORMAT=progressive

# Enable or disable logging
# ZM_RTMS_LOG_ENABLED=true
#########################################################
# Zoom Lens
#########################################################
# API key for the vision model provider
ANTHROPIC_API_KEY=

# Which model to call for Describe, Explain and Follow-up
VISION_MODEL=claude-opus-5

# Webhook secret token: proves this server owns the endpoint, and checks the
# signature on every webhook request
ZM_RTMS_SECRET_TOKEN=

# Public HTTPS address of this server, with no trailing slash: the host's
# address when deployed, or the ngrok tunnel locally. zoom-auth.js builds the
# OAuth redirect from it, so it must match the Marketplace setting.
ZOOM_LENS_PUBLIC_URL=

# Testing only, for a laptop. Leave all three at 0 on a server.
# Read this machine's display when the meeting media stream is unavailable
ZOOM_LENS_LOCAL_SCREEN=0
# Answer from the newest file in captures/ when nothing is live
ZOOM_LENS_ALLOW_RECORDED=0
# Save incoming screen-share video to captures/ (a recording of someone's screen)
ZOOM_LENS_SAVE_CAPTURES=0

# Saved recordings and development snapshots are deleted after this many hours
ZOOM_LENS_CAPTURE_HOURS=24
ZOOM_LENS_SNAPSHOT_HOURS=24

# Rate limiting, per participant
ZOOM_LENS_COOLDOWN_SECONDS=5
ZOOM_LENS_DAILY_LIMIT=60
